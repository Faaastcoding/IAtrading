//@version=6
// =====================================================================================
//  ICT — IRL → ERL | FVG H4 → M15 + Killzone  —  STRATÉGIE (backtestable)
//  Auteur : IA Trading
//
//  Différence avec l'indicateur :
//    • Entrée par ORDRE LIMIT au bord d'entrée du FVG M15 (bord proximal).
//        - Long  : limit au HAUT du FVG,  SL juste SOUS le FVG.
//        - Short : limit au BAS du FVG,   SL juste AU-DESSUS du FVG.
//    • Gestion réelle : TP1 à 1R (prise partielle 25% + passage BE), TP2 à 2R.
//    • Backtestable dans le Strategy Tester + alertes JSON prêtes pour webhook broker.
//
//  Plan de trade :
//    1. FVG H4 dans le sens du biais.
//    2. Tap de la zone H4.
//    3. FVG M15 même sens, en Killzone, du bon côté du 50% (Premium/Discount).
//    4. Ordre LIMIT au bord du FVG M15, SL sous/au-dessus du FVG, RR 1:2.
//    5. À 1R → BE + 25% de partiel.
//    6. Viser 2R (liquidité externe / ERL).
//
//  Conseil : appliquer sur un graphique M15 (le H4 est récupéré automatiquement).
// =====================================================================================

strategy("ICT IRL→ERL FVG H4→M15 [Strategy]", shorttitle="ICT FVG H4→M15 STRAT",
     overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500,
     pyramiding=0, initial_capital=10000, currency=currency.USD,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.0,
     calc_on_order_fills=false, process_orders_on_close=false)

// ─────────────────────────────────────────────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────────────────────────────────────────────
grpTF   = "1 · Timeframes"
htfTF   = input.timeframe("240", "Timeframe FVG de biais (HTF)", group=grpTF,
     tooltip="H4 par défaut. Applique la stratégie sur M15 pour l'entrée.")

grpBias = "2 · Biais / Tendance"
biasMode = input.string("Structure (BOS)", "Méthode de biais",
     options=["Structure (BOS)", "EMA HTF"], group=grpBias)
pvtLen   = input.int(5, "Longueur pivots HTF (structure)", minval=2, maxval=50, group=grpBias)
emaLen   = input.int(50, "Longueur EMA HTF", minval=5, maxval=400, group=grpBias)

grpPD   = "3 · Premium / Discount (50%)"
usePD    = input.bool(true, "Filtrer par Premium/Discount", group=grpPD,
     tooltip="Long uniquement en Discount (<50%), Short uniquement en Premium (>50%).")
showPD   = input.bool(true, "Afficher le dealing range + 50%", group=grpPD)

grpFVG  = "4 · Fair Value Gaps"
useDispl = input.bool(true, "Exiger un déplacement (bougie centrale directionnelle)", group=grpFVG)
minGapATR= input.float(0.0, "Taille min. du FVG (× ATR14, 0 = off)", minval=0, step=0.05, group=grpFVG)
showH4   = input.bool(true, "Afficher le dernier FVG H4", group=grpFVG)
showM15  = input.bool(true, "Afficher les FVG M15", group=grpFVG)
m15Keep  = input.int(1, "Nombre de FVG M15 affichés", minval=1, maxval=20, group=grpFVG,
     tooltip="1 = seulement le dernier FVG M15, pour un graphique clair.")

grpKZ   = "5 · Killzones (heure locale du marché)"
kzTz     = input.string("America/New_York", "Fuseau horaire", group=grpKZ,
     tooltip="Ex: America/New_York, Europe/London, UTC")
useAsia  = input.bool(false, "Asian KZ", inline="a", group=grpKZ)
asiaSess = input.session("2000-0000", "", inline="a", group=grpKZ)
useLdn   = input.bool(true,  "London KZ", inline="l", group=grpKZ)
ldnSess  = input.session("0200-0500", "", inline="l", group=grpKZ)
useNyAM  = input.bool(true,  "New York AM KZ", inline="n", group=grpKZ)
nyAmSess = input.session("0700-1000", "", inline="n", group=grpKZ)
useNyPM  = input.bool(false, "New York PM KZ", inline="p", group=grpKZ)
nyPmSess = input.session("1330-1600", "", inline="p", group=grpKZ)
shadeKZ  = input.bool(true, "Ombrer les killzones", group=grpKZ)

grpRisk = "6 · Gestion du risque"
rr        = input.float(2.0, "Ratio Risque/Rendement (TP2)", minval=1.0, step=0.5, group=grpRisk)
tp1R      = input.float(1.0, "Niveau TP1 partiel (en R)", minval=0.5, step=0.25, group=grpRisk)
partPct   = input.float(25.0, "% pris au TP1 (BE + partiel)", minval=1, maxval=99, group=grpRisk)
moveBE    = input.bool(true, "Passer en Break Even après TP1", group=grpRisk)
bufMode   = input.string("ATR", "Buffer du stop sous/au-dessus du FVG", options=["ATR", "Ticks"], group=grpRisk)
bufATR    = input.float(0.10, "Buffer stop (× ATR14)", minval=0, step=0.05, group=grpRisk)
bufTicks  = input.int(3, "Buffer stop (ticks)", minval=0, group=grpRisk)
riskPct   = input.float(1.0, "Risque par trade (% du capital)", minval=0.1, step=0.1, group=grpRisk)
expiryBars= input.int(12, "Expiration de l'ordre limit (bougies M15)", minval=1, group=grpRisk,
     tooltip="Annule l'ordre limit s'il n'est pas rempli après N bougies.")

grpBT   = "7 · Fenêtre de backtest"
useDates = input.bool(true, "Limiter le backtest à une période", group=grpBT,
     tooltip="Active pour ne tester que sur la fenêtre choisie (ex : 6 derniers mois).")
startDate= input.time(timestamp("10 Jan 2026 00:00 +0000"), "Début", group=grpBT)
endDate  = input.time(timestamp("10 Jul 2026 00:00 +0000"), "Fin",   group=grpBT)

grpUI   = "8 · Affichage"
showDash = input.bool(true, "Afficher le tableau de bord", group=grpUI)
drawLvls = input.bool(true, "Tracer les niveaux Entrée/SL/TP", group=grpUI)
colBull  = input.color(color.new(#26a69a, 0), "Couleur haussière", group=grpUI)
colBear  = input.color(color.new(#ef5350, 0), "Couleur baissière", group=grpUI)
colKZ    = input.color(color.new(#ffb74d, 88), "Couleur killzone", group=grpUI)

// ─────────────────────────────────────────────────────────────────────────────────────
//  DONNÉES HTF (H4) — non-repaint : on n'agit que sur bougie HTF clôturée
// ─────────────────────────────────────────────────────────────────────────────────────
atr14 = ta.atr(14)

[htfHigh, htfLow, htfClose, htfOpen] = request.security(syminfo.tickerid, htfTF,
     [high, low, close, open], lookahead=barmerge.lookahead_off)
htfPH  = request.security(syminfo.tickerid, htfTF, ta.pivothigh(pvtLen, pvtLen), lookahead=barmerge.lookahead_off)
htfPL  = request.security(syminfo.tickerid, htfTF, ta.pivotlow(pvtLen, pvtLen),  lookahead=barmerge.lookahead_off)
htfEma = request.security(syminfo.tickerid, htfTF, ta.ema(close, emaLen),        lookahead=barmerge.lookahead_off)

isNewHTF = ta.change(time(htfTF)) != 0

// Mémoire des 3 dernières bougies H4 clôturées (c1 = plus ancienne, c3 = plus récente)
var float H_c1 = na
var float H_c2 = na
var float H_c3 = na
var float L_c1 = na
var float L_c2 = na
var float L_c3 = na
var float O_c2 = na
var float C_c2 = na
var float O_c3 = na
var float C_c3 = na

if isNewHTF
    H_c1 := H_c2
    H_c2 := H_c3
    H_c3 := htfHigh[1]
    L_c1 := L_c2
    L_c2 := L_c3
    L_c3 := htfLow[1]
    O_c2 := O_c3
    O_c3 := htfOpen[1]
    C_c2 := C_c3
    C_c3 := htfClose[1]

// ─────────────────────────────────────────────────────────────────────────────────────
//  BIAIS H4
// ─────────────────────────────────────────────────────────────────────────────────────
var float lastPH = na
var float lastPL = na
if not na(htfPH)
    lastPH := htfPH
if not na(htfPL)
    lastPL := htfPL

var int biasStruct = 0
if not na(lastPH) and htfClose > lastPH
    biasStruct := 1
if not na(lastPL) and htfClose < lastPL
    biasStruct := -1

biasEma = htfClose > htfEma ? 1 : (htfClose < htfEma ? -1 : 0)
bias = biasMode == "EMA HTF" ? biasEma : biasStruct
isBull = bias == 1
isBear = bias == -1

// ─────────────────────────────────────────────────────────────────────────────────────
//  DEALING RANGE + 50% (Premium / Discount)  →  ERL = swings externes
// ─────────────────────────────────────────────────────────────────────────────────────
rangeHigh = lastPH
rangeLow  = lastPL
eq = (not na(rangeHigh) and not na(rangeLow)) ? (rangeHigh + rangeLow) / 2 : na
inDiscount = not na(eq) and close < eq
inPremium  = not na(eq) and close > eq

var box  pdBox    = na
var box  pdPrem   = na
var box  pdDisc   = na
var line eqLine   = na
var label eqLabel = na
if showPD and not na(eq) and barstate.islast
    left = bar_index - 200
    right = bar_index + 40
    box.delete(pdBox)
    box.delete(pdPrem)
    box.delete(pdDisc)
    line.delete(eqLine)
    label.delete(eqLabel)
    pdBox  := box.new(left, rangeHigh, right, rangeLow, border_color=color.new(color.gray, 60), bgcolor=na)
    pdPrem := box.new(left, rangeHigh, right, eq, border_color=na, bgcolor=color.new(colBear, 94))
    pdDisc := box.new(left, eq, right, rangeLow, border_color=na, bgcolor=color.new(colBull, 94))
    eqLine := line.new(left, eq, right, eq, color=color.new(color.orange, 0), style=line.style_dashed, width=1)
    eqLabel := label.new(right, eq, "  50% (EQ)", style=label.style_none, textcolor=color.orange, size=size.small)

// ─────────────────────────────────────────────────────────────────────────────────────
//  DÉTECTION FVG H4  →  zones de biais (IRL)
// ─────────────────────────────────────────────────────────────────────────────────────
minGapSize = minGapATR > 0 ? minGapATR * atr14 : 0.0

var float h4BullTop = na
var float h4BullBot = na
var bool  h4BullValid  = false
var bool  h4BullTapped = false
var float h4BearTop = na
var float h4BearBot = na
var bool  h4BearValid  = false
var bool  h4BearTapped = false
// Affichage : une seule boîte pour le DERNIER FVG H4 (effacée/remplacée)
var box   h4Box    = na
var int   h4BoxDir = 0

if isNewHTF and not na(H_c1)
    displOkBull = not useDispl or (C_c2 > O_c2)
    displOkBear = not useDispl or (C_c2 < O_c2)
    // FVG H4 haussier : low(c3) > high(c1)
    bullGap = L_c3 - H_c1
    if L_c3 > H_c1 and (bullGap >= minGapSize) and displOkBull
        h4BullTop := L_c3
        h4BullBot := H_c1
        h4BullValid := true
        h4BullTapped := false
        if showH4
            box.delete(h4Box)   // n'affiche que le dernier FVG H4
            h4Box := box.new(bar_index, h4BullTop, bar_index, h4BullBot,
                 border_color=color.new(colBull, 30), bgcolor=color.new(colBull, 82),
                 text="FVG H4", text_color=color.new(colBull, 10), text_size=size.tiny,
                 extend=extend.right)
            h4BoxDir := 1
    // FVG H4 baissier : high(c3) < low(c1)
    bearGap = L_c1 - H_c3
    if H_c3 < L_c1 and (bearGap >= minGapSize) and displOkBear
        h4BearTop := L_c1
        h4BearBot := H_c3
        h4BearValid := true
        h4BearTapped := false
        if showH4
            box.delete(h4Box)   // n'affiche que le dernier FVG H4
            h4Box := box.new(bar_index, h4BearTop, bar_index, h4BearBot,
                 border_color=color.new(colBear, 30), bgcolor=color.new(colBear, 82),
                 text="FVG H4", text_color=color.new(colBear, 10), text_size=size.tiny,
                 extend=extend.right)
            h4BoxDir := -1

// Invalidation (mitigation) des zones H4
if h4BullValid and close < h4BullBot
    h4BullValid := false
    h4BullTapped := false
    if h4BoxDir == 1
        box.delete(h4Box)
        h4Box := na
        h4BoxDir := 0
if h4BearValid and close > h4BearTop
    h4BearValid := false
    h4BearTapped := false
    if h4BoxDir == -1
        box.delete(h4Box)
        h4Box := na
        h4BoxDir := 0

// Tap de la zone H4
if h4BullValid and low <= h4BullTop and high >= h4BullBot
    h4BullTapped := true
if h4BearValid and high >= h4BearBot and low <= h4BearTop
    h4BearTapped := true

// ─────────────────────────────────────────────────────────────────────────────────────
//  DÉTECTION FVG M15 (timeframe du graphique) → déclencheur
// ─────────────────────────────────────────────────────────────────────────────────────
displChartBull = not useDispl or (close[1] > open[1])
displChartBear = not useDispl or (close[1] < open[1])
bullGapM = low - high[2]
bearGapM = low[2] - high

m15BullFVG = low > high[2] and (bullGapM >= minGapSize) and displChartBull
m15BearFVG = high < low[2] and (bearGapM >= minGapSize) and displChartBear

// N'affiche que les `m15Keep` derniers FVG M15 (les plus anciens sont effacés)
var array<box> m15Boxes = array.new<box>()
if showM15 and (m15BullFVG or m15BearFVG)
    box newBox = na
    if m15BullFVG
        newBox := box.new(bar_index - 2, low, bar_index, high[2], border_color=na, bgcolor=color.new(colBull, 75))
    else
        newBox := box.new(bar_index - 2, low[2], bar_index, high, border_color=na, bgcolor=color.new(colBear, 75))
    array.push(m15Boxes, newBox)
    while array.size(m15Boxes) > m15Keep
        box.delete(array.shift(m15Boxes))

// ─────────────────────────────────────────────────────────────────────────────────────
//  KILLZONES
// ─────────────────────────────────────────────────────────────────────────────────────
inSess(_use, _sess) => _use and not na(time(timeframe.period, _sess, kzTz))
inAsia = inSess(useAsia, asiaSess)
inLdn  = inSess(useLdn,  ldnSess)
inNyAM = inSess(useNyAM, nyAmSess)
inNyPM = inSess(useNyPM, nyPmSess)
inKZ = inAsia or inLdn or inNyAM or inNyPM

bgcolor(shadeKZ and inKZ ? colKZ : na, title="Killzone")

// ─────────────────────────────────────────────────────────────────────────────────────
//  SETUPS
// ─────────────────────────────────────────────────────────────────────────────────────
buffer = bufMode == "ATR" ? bufATR * atr14 : bufTicks * syminfo.mintick

pdOkLong  = not usePD or inDiscount
pdOkShort = not usePD or inPremium

inWindow = not useDates or (time >= startDate and time <= endDate)

longSetup  = isBull and h4BullValid and h4BullTapped and m15BullFVG and inKZ and pdOkLong  and inWindow and barstate.isconfirmed
shortSetup = isBear and h4BearValid and h4BearTapped and m15BearFVG and inKZ and pdOkShort and inWindow and barstate.isconfirmed

// ─────────────────────────────────────────────────────────────────────────────────────
//  MOTEUR D'ORDRES  (limit au bord du FVG, SL sous/au-dessus du FVG)
// ─────────────────────────────────────────────────────────────────────────────────────
var float entryPrice = na
var float slPrice     = na
var float tp1Price    = na
var float tp2Price    = na
var int   tradeDir    = 0        // 1 long, -1 short (position/ordre en cours)
var bool  pending     = false
var int   pendingLeft = 0
var float fullSize    = na
var bool  beMoved     = false

flat = strategy.position_size == 0

f_levels(_dir, _entry, _sl) =>
    _r  = math.abs(_entry - _sl)
    _t1 = _dir == 1 ? _entry + tp1R * _r : _entry - tp1R * _r
    _t2 = _dir == 1 ? _entry + rr   * _r : _entry - rr   * _r
    [_t1, _t2]

// N'affiche que le DERNIER setup tracé (efface le précédent) pour garder le graphique clair
var array<line>  tLines  = array.new<line>()
var array<label> tLabels = array.new<label>()
f_draw(_dir, _entry, _sl, _t1, _t2) =>
    if drawLvls
        while array.size(tLines) > 0
            line.delete(array.pop(tLines))
        while array.size(tLabels) > 0
            label.delete(array.pop(tLabels))
        x1 = bar_index
        x2 = bar_index + 30
        array.push(tLines, line.new(x1, _entry, x2, _entry, color=color.new(color.blue, 0), style=line.style_dotted, width=1))
        array.push(tLines, line.new(x1, _sl,    x2, _sl,    color=color.new(colBear, 0), style=line.style_dashed, width=1))
        array.push(tLines, line.new(x1, _t1,    x2, _t1,    color=color.new(color.orange, 0), style=line.style_dotted, width=1))
        array.push(tLines, line.new(x1, _t2,    x2, _t2,    color=color.new(colBull, 0), style=line.style_dashed, width=1))
        array.push(tLabels, label.new(x2, _entry, "LIMIT " + str.tostring(_entry, format.mintick), style=label.style_label_left,
             color=color.new(color.blue, 0), textcolor=color.white, size=size.tiny))
        array.push(tLabels, label.new(x2, _sl, "SL", style=label.style_label_left, color=color.new(colBear, 0),
             textcolor=color.white, size=size.tiny))
        array.push(tLabels, label.new(x2, _t1, "TP1 " + str.tostring(tp1R, "#.#") + "R (BE+" + str.tostring(partPct, "#") + "%)",
             style=label.style_label_left, color=color.new(color.orange, 0), textcolor=color.white, size=size.tiny))
        array.push(tLabels, label.new(x2, _t2, "TP2 " + str.tostring(rr, "#.#") + "R", style=label.style_label_left,
             color=color.new(colBull, 0), textcolor=color.white, size=size.tiny))

// ── Placement d'un nouvel ordre limit (seulement si à plat et sans ordre en attente) ──
canArm = flat and not pending

if canArm and longSetup
    e  = low                    // bord d'entrée du FVG haussier (haut du gap)
    s  = high[2] - buffer       // juste sous le FVG (borne basse = high[2])
    if s < e
        [t1, t2] = f_levels(1, e, s)
        q = (strategy.equity * riskPct / 100.0) / math.max(e - s, syminfo.mintick)
        entryPrice := e
        slPrice := s
        tp1Price := t1
        tp2Price := t2
        tradeDir := 1
        pending := true
        pendingLeft := expiryBars
        beMoved := false
        strategy.entry("Long", strategy.long, qty=q, limit=e,
             alert_message='{"action":"buy","symbol":"' + syminfo.ticker + '","order":"limit","price":' +
             str.tostring(e, format.mintick) + ',"sl":' + str.tostring(s, format.mintick) +
             ',"tp":' + str.tostring(t2, format.mintick) + '}')
        f_draw(1, e, s, t1, t2)

if canArm and shortSetup
    e  = high                   // bord d'entrée du FVG baissier (bas du gap)
    s  = low[2] + buffer        // juste au-dessus du FVG (borne haute = low[2])
    if s > e
        [t1, t2] = f_levels(-1, e, s)
        q = (strategy.equity * riskPct / 100.0) / math.max(s - e, syminfo.mintick)
        entryPrice := e
        slPrice := s
        tp1Price := t1
        tp2Price := t2
        tradeDir := -1
        pending := true
        pendingLeft := expiryBars
        beMoved := false
        strategy.entry("Short", strategy.short, qty=q, limit=e,
             alert_message='{"action":"sell","symbol":"' + syminfo.ticker + '","order":"limit","price":' +
             str.tostring(e, format.mintick) + ',"sl":' + str.tostring(s, format.mintick) +
             ',"tp":' + str.tostring(t2, format.mintick) + '}')
        f_draw(-1, e, s, t1, t2)

// ── Expiration / invalidation de l'ordre limit non rempli ──
if pending and flat
    pendingLeft := pendingLeft - 1
    invalidated = (tradeDir == 1 and not h4BullValid) or (tradeDir == -1 and not h4BearValid)
    if pendingLeft <= 0 or invalidated
        strategy.cancel("Long")
        strategy.cancel("Short")
        pending := false
        tradeDir := 0

// ── Détection du remplissage de l'entrée ──
justEntered = (strategy.position_size != 0) and (strategy.position_size[1] == 0)
if justEntered
    pending := false
    fullSize := math.abs(strategy.position_size)
    beMoved := false
    tradeDir := strategy.position_size > 0 ? 1 : -1

// ── Détection de la prise partielle TP1 (position réduite) → passage BE ──
if strategy.position_size != 0 and not na(fullSize) and math.abs(strategy.position_size) < fullSize * 0.999
    beMoved := true

// ── Gestion des sorties (TP1 partiel, TP2, stop / BE) ──
inLong  = strategy.position_size > 0
inShort = strategy.position_size < 0
curStop = (moveBE and beMoved) ? entryPrice : slPrice

if inLong
    if not beMoved
        strategy.exit("TP1", from_entry="Long", qty_percent=partPct, limit=tp1Price, stop=curStop,
             alert_message='{"action":"reduce","symbol":"' + syminfo.ticker + '","reason":"TP1"}')
    strategy.exit("TP2", from_entry="Long", limit=tp2Price, stop=curStop,
         alert_message='{"action":"close","symbol":"' + syminfo.ticker + '","reason":"TP2/SL"}')
if inShort
    if not beMoved
        strategy.exit("TP1", from_entry="Short", qty_percent=partPct, limit=tp1Price, stop=curStop,
             alert_message='{"action":"reduce","symbol":"' + syminfo.ticker + '","reason":"TP1"}')
    strategy.exit("TP2", from_entry="Short", limit=tp2Price, stop=curStop,
         alert_message='{"action":"close","symbol":"' + syminfo.ticker + '","reason":"TP2/SL"}')

// Réinitialisation à la clôture de position
if flat and not pending
    fullSize := na
    beMoved := false
    tradeDir := 0

// ─────────────────────────────────────────────────────────────────────────────────────
//  TABLEAU DE BORD
// ─────────────────────────────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 7, border_width=1)
if showDash and barstate.islast
    biasTxt = isBull ? "HAUSSIER ▲" : isBear ? "BAISSIER ▼" : "NEUTRE —"
    biasCol = isBull ? colBull : isBear ? colBear : color.gray
    pdTxt = na(eq) ? "—" : inDiscount ? "DISCOUNT" : "PREMIUM"
    pdCol = na(eq) ? color.gray : inDiscount ? colBull : colBear
    kzTxt = inKZ ? "OUVERTE" : "fermée"
    kzCol = inKZ ? color.new(#ffb74d, 0) : color.gray
    stateTxt = strategy.position_size != 0 ? (inLong ? "LONG en cours" : "SHORT en cours") :
                 pending ? "Ordre limit en attente" : "Flat"
    h4Txt = isBull ? (h4BullValid ? (h4BullTapped ? "H4 tapé ✓" : "H4 en attente") : "aucune") :
             isBear ? (h4BearValid ? (h4BearTapped ? "H4 tapé ✓" : "H4 en attente") : "aucune") : "—"
    table.cell(dash, 0, 0, "ICT STRAT", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small)
    table.cell(dash, 1, 0, htfTF + " → " + timeframe.period, text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small)
    table.cell(dash, 0, 1, "Biais", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, biasTxt, text_color=color.white, bgcolor=color.new(biasCol, 20), text_size=size.small)
    table.cell(dash, 0, 2, "Zone H4", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, h4Txt, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 3, "50%", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, pdTxt, text_color=color.white, bgcolor=color.new(pdCol, 40), text_size=size.small)
    table.cell(dash, 0, 4, "Killzone", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, kzTxt, text_color=color.white, bgcolor=color.new(kzCol, 40), text_size=size.small)
    table.cell(dash, 0, 5, "État", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, stateTxt, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 6, "Risque/trade", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(riskPct, "#.#") + "% · 1:" + str.tostring(rr, "#.#"), text_color=color.white, text_size=size.small)
