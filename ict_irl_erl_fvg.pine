//@version=6
// =====================================================================================
//  ICT — IRL → ERL | FVG H4 → M15 + Killzone (Premium/Discount)
//  Auteur : IA Trading
//  Concepts imbriqués :
//    • IRL to ERL  : le FVG (liquidité interne) sert d'entrée, les swings H/L
//                    (liquidité externe) servent de cibles.
//    • FVG         : Fair Value Gap détecté en H4 (biais) et en M15 (déclencheur).
//    • 50%         : equilibrium du dealing range → Premium (vente) / Discount (achat).
//    • Killzone    : entrée M15 valide UNIQUEMENT en killzone.
//
//  Plan de trade automatisé :
//    1. Attendre un FVG H4 dans le sens du biais.
//    2. Attendre que la zone H4 soit touchée (tap).
//    3. Chercher un FVG M15 dans le même sens, en Killzone, du bon côté du 50%.
//    4. Entrée avec RR 1:2.
//    5. À 1R  → Break Even + 25% de profit (matérialisé par la ligne TP1).
//    6. Viser 2R (TP2 = liquidité externe / ERL).
//
//  Conseil d'utilisation : appliquer l'indicateur sur un graphique M15.
// =====================================================================================

indicator("ICT IRL→ERL | FVG H4→M15 Killzone", shorttitle="ICT FVG H4→M15", overlay=true,
     max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────────────────────────────────────────────
grpTF   = "1 · Timeframes"
htfTF   = input.timeframe("240", "Timeframe FVG de biais (HTF)", group=grpTF,
     tooltip="H4 par défaut. Applique l'indicateur sur M15 pour l'entrée.")

grpBias = "2 · Biais / Tendance"
biasMode = input.string("Structure (BOS)", "Méthode de biais",
     options=["Structure (BOS)", "EMA HTF"], group=grpBias)
pvtLen   = input.int(5, "Longueur pivots HTF (structure)", minval=2, maxval=50, group=grpBias)
emaLen   = input.int(50, "Longueur EMA HTF", minval=5, maxval=400, group=grpBias)

grpPD   = "3 · Premium / Discount (50%)"
usePD    = input.bool(true, "Filtrer par Premium/Discount", group=grpPD,
     tooltip="Long uniquement en Discount (<50%), Short uniquement en Premium (>50%).")
showPD   = input.bool(true, "Afficher le dealing range + 50%", group=grpPD)

grpFVG  = "4 · Fair Value Gaps"
useDispl = input.bool(true, "Exiger un déplacement (bougie centrale directionnelle)", group=grpFVG)
minGapATR= input.float(0.0, "Taille min. du FVG (× ATR14, 0 = off)", minval=0, step=0.05, group=grpFVG)
showH4   = input.bool(true, "Afficher le dernier FVG H4", group=grpFVG)
showM15  = input.bool(true, "Afficher les FVG M15", group=grpFVG)
m15Keep  = input.int(1, "Nombre de FVG M15 affichés", minval=1, maxval=20, group=grpFVG,
     tooltip="1 = seulement le dernier FVG M15, pour un graphique clair.")

grpKZ   = "5 · Killzones (heure locale du marché)"
kzTz     = input.string("America/New_York", "Fuseau horaire", group=grpKZ,
     tooltip="Ex: America/New_York, Europe/London, UTC")
useAsia  = input.bool(false, "Asian KZ", inline="a", group=grpKZ)
asiaSess = input.session("2000-0000", "", inline="a", group=grpKZ)
useLdn   = input.bool(true,  "London KZ", inline="l", group=grpKZ)
ldnSess  = input.session("0200-0500", "", inline="l", group=grpKZ)
useNyAM  = input.bool(true,  "New York AM KZ", inline="n", group=grpKZ)
nyAmSess = input.session("0700-1000", "", inline="n", group=grpKZ)
useNyPM  = input.bool(false, "New York PM KZ", inline="p", group=grpKZ)
nyPmSess = input.session("1330-1600", "", inline="p", group=grpKZ)
shadeKZ  = input.bool(true, "Ombrer les killzones", group=grpKZ)

grpRisk = "6 · Gestion du risque"
rr       = input.float(2.0, "Ratio Risque/Rendement (TP2)", minval=1.0, step=0.5, group=grpRisk)
tp1R     = input.float(1.0, "Niveau TP1 partiel (en R)", minval=0.5, step=0.25, group=grpRisk)
partPct  = input.float(25.0, "% pris au TP1 (BE + partiel)", minval=1, maxval=99, group=grpRisk)
bufMode  = input.string("ATR", "Buffer du stop sous/au-dessus du FVG", options=["ATR", "Ticks"], group=grpRisk)
bufATR   = input.float(0.10, "Buffer stop (× ATR14)", minval=0, step=0.05, group=grpRisk)
bufTicks = input.int(3, "Buffer stop (ticks)", minval=0, group=grpRisk)
projLen  = input.int(40, "Longueur projection des niveaux (bougies)", minval=5, group=grpRisk)

grpUI   = "7 · Affichage"
showDash = input.bool(true, "Afficher le tableau de bord", group=grpUI)
colBull  = input.color(color.new(#26a69a, 0), "Couleur haussière", group=grpUI)
colBear  = input.color(color.new(#ef5350, 0), "Couleur baissière", group=grpUI)
colKZ    = input.color(color.new(#ffb74d, 88), "Couleur killzone", group=grpUI)

grpAlert = "8 · Alertes"
alertFullSetup = input.bool(true,  "Alerte SETUP COMPLET (toutes confirmations)", group=grpAlert,
     tooltip="Se déclenche quand FVG H4 tapé + FVG M15 même sens + Killzone + Premium/Discount sont réunis. C'est l'alerte à envoyer sur Telegram.")
alertM15Heads  = input.bool(false, "Alerte pré-signal (FVG M15 en Killzone)", group=grpAlert,
     tooltip="Alerte plus précoce, moins stricte. Désactivée par défaut pour éviter le bruit.")

// ─────────────────────────────────────────────────────────────────────────────────────
//  DONNÉES HTF (H4) — non-repaint : on n'agit que sur bougie HTF clôturée
// ─────────────────────────────────────────────────────────────────────────────────────
atr14 = ta.atr(14)

[htfHigh, htfLow, htfClose, htfOpen] = request.security(syminfo.tickerid, htfTF,
     [high, low, close, open], lookahead=barmerge.lookahead_off)
htfPH  = request.security(syminfo.tickerid, htfTF, ta.pivothigh(pvtLen, pvtLen), lookahead=barmerge.lookahead_off)
htfPL  = request.security(syminfo.tickerid, htfTF, ta.pivotlow(pvtLen, pvtLen),  lookahead=barmerge.lookahead_off)
htfEma = request.security(syminfo.tickerid, htfTF, ta.ema(close, emaLen),        lookahead=barmerge.lookahead_off)

isNewHTF = ta.change(time(htfTF)) != 0

// Mémoire des 3 dernières bougies H4 clôturées (c1 = plus ancienne, c3 = plus récente).
// La bougie centrale c2 sert au test de déplacement (open/close).
var float H_c1 = na
var float H_c2 = na
var float H_c3 = na
var float L_c1 = na
var float L_c2 = na
var float L_c3 = na
var float O_c2 = na
var float C_c2 = na
var float O_c3 = na
var float C_c3 = na

if isNewHTF
    // htfHigh[1] = valeur finale de la bougie H4 qui vient de clôturer
    H_c1 := H_c2
    H_c2 := H_c3
    H_c3 := htfHigh[1]
    L_c1 := L_c2
    L_c2 := L_c3
    L_c3 := htfLow[1]
    O_c2 := O_c3
    O_c3 := htfOpen[1]
    C_c2 := C_c3
    C_c3 := htfClose[1]

// ─────────────────────────────────────────────────────────────────────────────────────
//  BIAIS H4
// ─────────────────────────────────────────────────────────────────────────────────────
var float lastPH = na
var float lastPL = na
if not na(htfPH)
    lastPH := htfPH
if not na(htfPL)
    lastPL := htfPL

var int biasStruct = 0
if not na(lastPH) and htfClose > lastPH
    biasStruct := 1
if not na(lastPL) and htfClose < lastPL
    biasStruct := -1

biasEma = htfClose > htfEma ? 1 : (htfClose < htfEma ? -1 : 0)
bias = biasMode == "EMA HTF" ? biasEma : biasStruct
isBull = bias == 1
isBear = bias == -1

// ─────────────────────────────────────────────────────────────────────────────────────
//  DEALING RANGE + 50% (Premium / Discount)  →  ERL = swings externes
// ─────────────────────────────────────────────────────────────────────────────────────
rangeHigh = lastPH
rangeLow  = lastPL
eq = (not na(rangeHigh) and not na(rangeLow)) ? (rangeHigh + rangeLow) / 2 : na
inDiscount = not na(eq) and close < eq
inPremium  = not na(eq) and close > eq

var box  pdBox    = na
var box  pdPrem   = na
var box  pdDisc   = na
var line eqLine   = na
var label eqLabel = na
if showPD and not na(eq) and barstate.islast
    left = bar_index - 200
    right = bar_index + projLen
    box.delete(pdBox)
    box.delete(pdPrem)
    box.delete(pdDisc)
    line.delete(eqLine)
    label.delete(eqLabel)
    pdBox  := box.new(left, rangeHigh, right, rangeLow, border_color=color.new(color.gray, 60), bgcolor=na)
    pdPrem := box.new(left, rangeHigh, right, eq, border_color=na, bgcolor=color.new(colBear, 94)) // premium (haut)
    pdDisc := box.new(left, eq, right, rangeLow, border_color=na, bgcolor=color.new(colBull, 94)) // discount (bas)
    eqLine := line.new(left, eq, right, eq, color=color.new(color.orange, 0), style=line.style_dashed, width=1)
    eqLabel := label.new(right, eq, "  50% (EQ)", style=label.style_none, textcolor=color.orange, size=size.small)

// ─────────────────────────────────────────────────────────────────────────────────────
//  DÉTECTION FVG H4  →  zones de biais (IRL)
// ─────────────────────────────────────────────────────────────────────────────────────
minGapSize = minGapATR > 0 ? minGapATR * atr14 : 0.0

// Zone H4 haussière active (support / demande)
var float h4BullTop = na
var float h4BullBot = na
var bool  h4BullValid  = false
var bool  h4BullTapped = false
var bool  h4BullUsed   = false
// Zone H4 baissière active (résistance / offre)
var float h4BearTop = na
var float h4BearBot = na
var bool  h4BearValid  = false
var bool  h4BearTapped = false
var bool  h4BearUsed   = false
// Affichage : une seule boîte pour le DERNIER FVG H4 (effacée/remplacée)
var box   h4Box    = na
var int   h4BoxDir = 0

if isNewHTF and not na(H_c1)
    displOkBull = not useDispl or (C_c2 > O_c2)
    displOkBear = not useDispl or (C_c2 < O_c2)
    // FVG H4 haussier : low(c3) > high(c1)
    bullGap = L_c3 - H_c1
    if L_c3 > H_c1 and (bullGap >= minGapSize) and displOkBull
        h4BullTop := L_c3
        h4BullBot := H_c1
        h4BullValid := true
        h4BullTapped := false
        h4BullUsed := false
        if showH4
            box.delete(h4Box)   // n'affiche que le dernier FVG H4
            h4Box := box.new(bar_index, h4BullTop, bar_index, h4BullBot,
                 border_color=color.new(colBull, 30), bgcolor=color.new(colBull, 82),
                 text="FVG H4", text_color=color.new(colBull, 10), text_size=size.tiny,
                 extend=extend.right)
            h4BoxDir := 1
    // FVG H4 baissier : high(c3) < low(c1)
    bearGap = L_c1 - H_c3
    if H_c3 < L_c1 and (bearGap >= minGapSize) and displOkBear
        h4BearTop := L_c1
        h4BearBot := H_c3
        h4BearValid := true
        h4BearTapped := false
        h4BearUsed := false
        if showH4
            box.delete(h4Box)   // n'affiche que le dernier FVG H4
            h4Box := box.new(bar_index, h4BearTop, bar_index, h4BearBot,
                 border_color=color.new(colBear, 30), bgcolor=color.new(colBear, 82),
                 text="FVG H4", text_color=color.new(colBear, 10), text_size=size.tiny,
                 extend=extend.right)
            h4BoxDir := -1

// Invalidation (mitigation) des zones H4
if h4BullValid and close < h4BullBot
    h4BullValid := false
    h4BullTapped := false
    if h4BoxDir == 1
        box.delete(h4Box)
        h4Box := na
        h4BoxDir := 0
if h4BearValid and close > h4BearTop
    h4BearValid := false
    h4BearTapped := false
    if h4BoxDir == -1
        box.delete(h4Box)
        h4Box := na
        h4BoxDir := 0

// Tap de la zone H4 (le prix revient dans le FVG H4)
if h4BullValid and low <= h4BullTop and high >= h4BullBot
    h4BullTapped := true
if h4BearValid and high >= h4BearBot and low <= h4BearTop
    h4BearTapped := true

// ─────────────────────────────────────────────────────────────────────────────────────
//  DÉTECTION FVG M15 (timeframe du graphique) → déclencheur d'entrée
// ─────────────────────────────────────────────────────────────────────────────────────
displChartBull = not useDispl or (close[1] > open[1])
displChartBear = not useDispl or (close[1] < open[1])
bullGapM = low - high[2]
bearGapM = low[2] - high

m15BullFVG = low > high[2] and (bullGapM >= minGapSize) and displChartBull
m15BearFVG = high < low[2] and (bearGapM >= minGapSize) and displChartBear

// N'affiche que les `m15Keep` derniers FVG M15 (les plus anciens sont effacés)
var array<box> m15Boxes = array.new<box>()
if showM15 and (m15BullFVG or m15BearFVG)
    box newBox = na
    if m15BullFVG
        newBox := box.new(bar_index - 2, low, bar_index, high[2], border_color=na, bgcolor=color.new(colBull, 75))
    else
        newBox := box.new(bar_index - 2, low[2], bar_index, high, border_color=na, bgcolor=color.new(colBear, 75))
    array.push(m15Boxes, newBox)
    while array.size(m15Boxes) > m15Keep
        box.delete(array.shift(m15Boxes))

// ─────────────────────────────────────────────────────────────────────────────────────
//  KILLZONES
// ─────────────────────────────────────────────────────────────────────────────────────
inSess(_use, _sess) => _use and not na(time(timeframe.period, _sess, kzTz))
inAsia = inSess(useAsia, asiaSess)
inLdn  = inSess(useLdn,  ldnSess)
inNyAM = inSess(useNyAM, nyAmSess)
inNyPM = inSess(useNyPM, nyPmSess)
inKZ = inAsia or inLdn or inNyAM or inNyPM

bgcolor(shadeKZ and inKZ ? colKZ : na, title="Killzone")

// ─────────────────────────────────────────────────────────────────────────────────────
//  LOGIQUE D'ENTRÉE (M15) + GESTION DU TRADE
// ─────────────────────────────────────────────────────────────────────────────────────
buffer = bufMode == "ATR" ? bufATR * atr14 : bufTicks * syminfo.mintick

pdOkLong  = not usePD or inDiscount
pdOkShort = not usePD or inPremium

longSetup  = isBull and h4BullValid and h4BullTapped and not h4BullUsed and m15BullFVG and inKZ and pdOkLong
shortSetup = isBear and h4BearValid and h4BearTapped and not h4BearUsed and m15BearFVG and inKZ and pdOkShort

longSignal  = longSetup  and barstate.isconfirmed
shortSignal = shortSetup and barstate.isconfirmed

// Prépare les niveaux du trade — n'affiche que le DERNIER setup (efface le précédent)
var array<line>  tLines  = array.new<line>()
var array<label> tLabels = array.new<label>()
f_drawTrade(_isLong, _entry, _stop) =>
    // Efface le tracé du setup précédent pour garder le graphique clair
    while array.size(tLines) > 0
        line.delete(array.pop(tLines))
    while array.size(tLabels) > 0
        label.delete(array.pop(tLabels))
    r = math.abs(_entry - _stop)
    tp1 = _isLong ? _entry + tp1R * r : _entry - tp1R * r
    tp2 = _isLong ? _entry + rr   * r : _entry - rr   * r
    x2 = bar_index + projLen
    // Lignes
    array.push(tLines, line.new(bar_index, _entry, x2, _entry, color=color.new(color.blue, 0), width=2))
    array.push(tLines, line.new(bar_index, _stop,  x2, _stop,  color=color.new(colBear, 0), style=line.style_dashed, width=1))
    array.push(tLines, line.new(bar_index, tp1,    x2, tp1,    color=color.new(color.orange, 0), style=line.style_dotted, width=1))
    array.push(tLines, line.new(bar_index, tp2,    x2, tp2,    color=color.new(colBull, 0), style=line.style_dashed, width=1))
    // Labels
    array.push(tLabels, label.new(x2, _entry, "Entrée limit " + str.tostring(_entry, format.mintick), style=label.style_label_left,
         color=color.new(color.blue, 0), textcolor=color.white, size=size.small))
    array.push(tLabels, label.new(x2, _stop, "SL " + str.tostring(_stop, format.mintick), style=label.style_label_left,
         color=color.new(colBear, 0), textcolor=color.white, size=size.small))
    array.push(tLabels, label.new(x2, tp1, "TP1 " + str.tostring(tp1R, "#.#") + "R → BE + " + str.tostring(partPct, "#") + "%",
         style=label.style_label_left, color=color.new(color.orange, 0), textcolor=color.white, size=size.small))
    array.push(tLabels, label.new(x2, tp2, "TP2 " + str.tostring(rr, "#.#") + "R", style=label.style_label_left,
         color=color.new(colBull, 0), textcolor=color.white, size=size.small))

if longSignal
    entry = low            // bord d'entrée du FVG M15 (haut du gap) → ordre limit
    stop  = high[2] - buffer   // juste sous le FVG (borne basse = high[2])
    if stop < entry
        f_drawTrade(true, entry, stop)
        label.new(bar_index, low, "▲ LONG", style=label.style_label_up, color=color.new(colBull, 0),
             textcolor=color.white, size=size.small, yloc=yloc.belowbar)
        h4BullUsed := true
        if alertFullSetup
            rL   = entry - stop
            tp1L = entry + tp1R * rL
            tp2L = entry + rr   * rL
            alert("🟢 SETUP LONG ICT — " + syminfo.ticker + " (" + timeframe.period + ")" +
                 "\nToutes confirmations OK ✓ (Killzone + FVG H4 tapé + FVG M15 + Discount)" +
                 "\nEntrée limit : " + str.tostring(entry, format.mintick) +
                 "\nSL : " + str.tostring(stop, format.mintick) +
                 "\nTP1 (1R → BE + " + str.tostring(partPct, "#") + "%) : " + str.tostring(tp1L, format.mintick) +
                 "\nTP2 (2R) : " + str.tostring(tp2L, format.mintick) +
                 "\nRR 1:" + str.tostring(rr, "#.#"), alert.freq_once_per_bar_close)

if shortSignal
    entry = high           // bord d'entrée du FVG M15 (bas du gap) → ordre limit
    stop  = low[2] + buffer    // juste au-dessus du FVG (borne haute = low[2])
    if stop > entry
        f_drawTrade(false, entry, stop)
        label.new(bar_index, high, "▼ SHORT", style=label.style_label_down, color=color.new(colBear, 0),
             textcolor=color.white, size=size.small, yloc=yloc.abovebar)
        h4BearUsed := true
        if alertFullSetup
            rS   = stop - entry
            tp1S = entry - tp1R * rS
            tp2S = entry - rr   * rS
            alert("🔴 SETUP SHORT ICT — " + syminfo.ticker + " (" + timeframe.period + ")" +
                 "\nToutes confirmations OK ✓ (Killzone + FVG H4 tapé + FVG M15 + Premium)" +
                 "\nEntrée limit : " + str.tostring(entry, format.mintick) +
                 "\nSL : " + str.tostring(stop, format.mintick) +
                 "\nTP1 (1R → BE + " + str.tostring(partPct, "#") + "%) : " + str.tostring(tp1S, format.mintick) +
                 "\nTP2 (2R) : " + str.tostring(tp2S, format.mintick) +
                 "\nRR 1:" + str.tostring(rr, "#.#"), alert.freq_once_per_bar_close)

// Marqueurs de tap H4 (info)
plotshape(h4BullValid and h4BullTapped and not h4BullTapped[1] ? low : na, "Tap H4 Bull",
     shape.circle, location.belowbar, color=color.new(colBull, 30), size=size.tiny)
plotshape(h4BearValid and h4BearTapped and not h4BearTapped[1] ? high : na, "Tap H4 Bear",
     shape.circle, location.abovebar, color=color.new(colBear, 30), size=size.tiny)

// ─────────────────────────────────────────────────────────────────────────────────────
//  ALERTES
// ─────────────────────────────────────────────────────────────────────────────────────
// Alerte demandée : FVG M15 formé PENDANT une Killzone (l'instant où le gap se trace)
m15BullKZ = m15BullFVG and inKZ and barstate.isconfirmed
m15BearKZ = m15BearFVG and inKZ and barstate.isconfirmed
m15FvgKZ  = m15BullKZ or m15BearKZ

alertcondition(m15FvgKZ, "FVG M15 en Killzone",
     "FVG M15 en Killzone sur {{ticker}} {{interval}} @ {{close}}")

if m15FvgKZ and alertM15Heads
    dirTxt = m15BullKZ ? "HAUSSIER" : "BAISSIER"
    dirEmo = m15BullKZ ? "🟢" : "🔴"
    alert(dirEmo + " Pré-signal : FVG M15 en Killzone (" + dirTxt + ")" +
         "\nActif : " + syminfo.ticker + "  (" + timeframe.period + ")" +
         "\nPrix : " + str.tostring(close, format.mintick) +
         "\nBiais H4 : " + (isBull ? "haussier" : isBear ? "baissier" : "neutre") +
         "\nZone H4 : " + (m15BullKZ ? (h4BullTapped ? "tapée ✓" : "non tapée") :
                                       (h4BearTapped ? "tapée ✓" : "non tapée")),
         alert.freq_once_per_bar_close)

// Conditions nommées (pour créer une alerte ciblée si tu préfères ne pas utiliser
// « Any alert() function call »). Le message riche avec les niveaux passe par alert().
alertcondition(longSignal,  "ICT LONG",  "SETUP LONG ICT confirmé sur {{ticker}} {{interval}} @ {{close}}")
alertcondition(shortSignal, "ICT SHORT", "SETUP SHORT ICT confirmé sur {{ticker}} {{interval}} @ {{close}}")

// ─────────────────────────────────────────────────────────────────────────────────────
//  TABLEAU DE BORD
// ─────────────────────────────────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 7, border_width=1)
if showDash and barstate.islast
    biasTxt = isBull ? "HAUSSIER ▲" : isBear ? "BAISSIER ▼" : "NEUTRE —"
    biasCol = isBull ? colBull : isBear ? colBear : color.gray
    pdTxt = na(eq) ? "—" : inDiscount ? "DISCOUNT" : "PREMIUM"
    pdCol = na(eq) ? color.gray : inDiscount ? colBull : colBear
    kzTxt = inKZ ? "OUVERTE" : "fermée"
    kzCol = inKZ ? color.new(#ffb74d, 0) : color.gray
    h4Txt = isBull ? (h4BullValid ? (h4BullTapped ? "H4 tapé ✓" : "H4 en attente") : "aucune") :
             isBear ? (h4BearValid ? (h4BearTapped ? "H4 tapé ✓" : "H4 en attente") : "aucune") : "—"
    table.cell(dash, 0, 0, "ICT IRL→ERL", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small)
    table.cell(dash, 1, 0, htfTF + " → " + timeframe.period, text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small)
    table.cell(dash, 0, 1, "Biais", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, biasTxt, text_color=color.white, bgcolor=color.new(biasCol, 20), text_size=size.small)
    table.cell(dash, 0, 2, "Zone H4", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, h4Txt, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 3, "50%", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, pdTxt, text_color=color.white, bgcolor=color.new(pdCol, 40), text_size=size.small)
    table.cell(dash, 0, 4, "Killzone", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, kzTxt, text_color=color.white, bgcolor=color.new(kzCol, 40), text_size=size.small)
    table.cell(dash, 0, 5, "RR cible", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, "1:" + str.tostring(rr, "#.#"), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 6, "TP1", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(tp1R, "#.#") + "R → BE + " + str.tostring(partPct, "#") + "%", text_color=color.white, text_size=size.small)
